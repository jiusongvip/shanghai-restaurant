---
import ArticleSchema from "../components/ArticleSchema.astro";
import Layout from "../layouts/Layout.astro";

const menuCategories = [
  {
    name: "Dim Sum & Starters",
    items: [
      { name: "Xiaolongbao (Pork)", price: "RMB 28-48", desc: "Steamed soup dumplings with pork filling" },
      { name: "Xiaolongbao (Crab Roe)", price: "RMB 48-88", desc: "Seasonal crab roe and pork soup dumplings" },
      { name: "Shengjianbao", price: "RMB 18-30", desc: "Pan-fried pork buns with crispy bottom" },
      { name: "Shao Mai", price: "RMB 22-38", desc: "Open-topped steamed dumplings with sticky rice" },
      { name: "Spring Rolls", price: "RMB 18-28", desc: "Crispy deep-fried rolls with vegetable filling" },
      { name: "Wontons in Chili Oil", price: "RMB 24-36", desc: "Pork wontons dressed in spicy chili oil" },
    ]
  },
  {
    name: "Soups",
    items: [
      { name: "Yan Du Xian", price: "RMB 68-128", desc: "Bamboo shoot, cured pork, and tofu skin soup" },
      { name: "Hot and Sour Soup", price: "RMB 22-38", desc: "Classic Shanghainese pepper and vinegar soup" },
      { name: "Fish Head Soup", price: "RMB 88-168", desc: "Rich milky broth with whole fish head and tofu" },
    ]
  },
  {
    name: "Main Dishes",
    items: [
      { name: "Hongshao Rou", price: "RMB 58-98", desc: "Red braised pork belly, meltingly tender" },
      { name: "Dongpo Pork", price: "RMB 68-118", desc: "Slow-braised pork belly in soy and Shaoxing wine" },
      { name: "Sweet and Sour Spareribs", price: "RMB 48-78", desc: "Glazed ribs in tangy sweet-sour sauce" },
      { name: "Lion''s Head Meatballs", price: "RMB 52-88", desc: "Giant pork meatballs braised with cabbage" },
      { name: "Squirrel-Shaped Mandarin Fish", price: "RMB 128-198", desc: "Crispy fried whole fish in sweet-sour sauce" },
      { name: "Stir-Fried River Shrimp", price: "RMB 68-108", desc: "Tiny freshwater shrimp quickly wok-fried" },
    ]
  },
  {
    name: "Seafood & Seasonal",
    items: [
      { name: "Steamed Hairy Crab (seasonal)", price: "RMB 168-388", desc: "Whole steamed crab with ginger vinegar" },
      { name: "Smoked Fish", price: "RMB 38-58", desc: "Cold-smoked fish appetizer, sweet and savory" },
      { name: "Crab Roe Tofu", price: "RMB 78-128", desc: "Silky tofu with golden crab roe" },
      { name: "Yellow Croaker in Soy Sauce", price: "RMB 88-158", desc: "Whole fish braised in soy and scallion oil" },
    ]
  },
  {
    name: "Rice & Noodles",
    items: [
      { name: "Shanghai Fried Noodles", price: "RMB 28-42", desc: "Thick noodles wok-fried with pork and cabbage" },
      { name: "Scallion Oil Noodles", price: "RMB 18-28", desc: "Simple noodles tossed in sizzling scallion oil" },
      { name: "Yangzhou Fried Rice", price: "RMB 32-48", desc: "Classic fried rice with char siu and shrimp" },
      { name: "Rice Cake with Pork", price: "RMB 35-55", desc: "Chewy rice cakes stir-fried with shredded pork" },
    ]
  },
  {
    name: "Desserts",
    items: [
      { name: "Tangyuan", price: "RMB 18-28", desc: "Glutinous rice balls in sweet fermented rice soup" },
      { name: "Osmanthus Cake", price: "RMB 22-32", desc: "Steamed rice cake with sweet osmanthus syrup" },
      { name: "Egg Tarts", price: "RMB 15-25", desc: "Flaky pastry shells with silky egg custard" },
    ]
  },
];
---

<Layout
  fullTitle="Shanghai Restaurant Menu & Price Guide"
  description="Complete Shanghai restaurant menu guide with prices. From xiaolongbao to hongshao rou, discover what to order and how much it costs at Shanghai restaurants."
>

  <main>
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 md:pt-28 pb-12">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-6xl tracking-tighter leading-none font-semibold text-slate-900">
          Shanghai Restaurant Menu Guide
        </h1>
        <p class="text-lg text-slate-500 mt-6 leading-relaxed max-w-[60ch]">
          A comprehensive guide to typical Shanghai restaurant menus. Learn what to order, understand the price ranges, and navigate the full spectrum of Shanghainese cuisine like a local.
        </p>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="space-y-12">
        {menuCategories.map((cat) => (
          <div>
            <h2 class="text-xl font-semibold text-slate-900 mb-4 pb-2 border-b border-slate-100">{cat.name}</h2>
            <div class="space-y-3">
              {cat.items.map((item) => (
                <div class="flex items-start justify-between gap-4 py-2">
                  <div>
                    <h3 class="font-medium text-slate-900">{item.name}</h3>
                    <p class="text-sm text-slate-500">{item.desc}</p>
                  </div>
                  <span class="text-sm font-medium text-accent-600 whitespace-nowrap">{item.price}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="card-soft bg-slate-50 p-8 md:p-12">
        <h2 class="text-xl font-semibold text-slate-900 mb-4">Price Guide</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <div>
            <h3 class="font-medium text-accent-600">Budget (RMB 20-80)</h3>
            <p class="text-sm text-slate-500 mt-1">Street food stalls, dumpling shops, noodle houses. Yang''s Fried Dumpling, Nanxiang.</p>
          </div>
          <div>
            <h3 class="font-medium text-accent-600">Moderate (RMB 80-250)</h3>
            <p class="text-sm text-slate-500 mt-1">Casual sit-down restaurants, popular chains. Jia Jia Tang Bao, Din Tai Fung, Old Jesse.</p>
          </div>
          <div>
            <h3 class="font-medium text-accent-600">Premium (RMB 250+)</h3>
            <p class="text-sm text-slate-500 mt-1">Fine dining, Michelin-starred, tasting menus. Fu He Hui, YongFoo Elite, Xin Rong Ji.</p>
          </div>
        </div>
        <p class="text-xs text-slate-400 mt-6">Prices are approximate per person and may vary by location and season.</p>
      </div>
    </section>
  </main>

  <ArticleSchema
    headline="Shanghai Restaurant Menu Guide"
    description="Complete Shanghai restaurant menu guide with prices"
    url="https://shanghai-restaurant.com/shanghai-restaurant-menu"
  />
</Layout>
