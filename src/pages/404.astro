---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page Not Found"
  description="Sorry, the page you are looking for does not exist."
  noindex
>
  <main>
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 md:pt-40 pb-24 text-center">
      <h1 class="text-6xl md:text-8xl font-bold text-slate-200">404</h1>
      <p class="text-xl text-slate-500 mt-6">The page you are looking for does not exist.</p>
      <div class="mt-8">
        <a href="/" class="btn-soft bg-accent-600 hover:bg-accent-700 text-white text-sm font-medium px-6 py-3 transition-colors inline-flex items-center gap-2">
          &larr; Back to Home
        </a>
      </div>
    </section>
  </main>
</Layout>
