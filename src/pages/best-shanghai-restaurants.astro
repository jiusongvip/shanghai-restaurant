---
import Layout from "../layouts/Layout.astro";
import RestaurantCard from "../components/RestaurantCard.astro";
import Faq from "../components/Faq.astro";
import { allRestaurants } from "../data/restaurants";

const faqsBest = [
  { q: "How do you pick the best Shanghai restaurants?", a: "We evaluate based on food quality, authenticity, atmosphere, value, and consistency. Our team dines anonymously and revisits regularly to keep rankings fresh." },
  { q: "What is the best Shanghai restaurant for first-timers?", a: "For first-timers, Yang''s Fried Dumpling offers the essential Shanghai street food experience, while Old Jesse provides an authentic sit-down introduction to Benbang cuisine." },
  { q: "Are Shanghai restaurants expensive?", a: "Shanghai has options across all price points. Great street food starts from RMB 20, while Michelin-starred tasting menus can run RMB 1,000+. The city truly excels at both extremes." },
];
---

<Layout
  title="15 Best Shanghai Restaurants"
  description="We have tried and ranked the 15 best Shanghai restaurants for 2026. From authentic xiaolongbao to fine dining Shanghai cuisine — updated regularly."
>

  <main>
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 md:pt-28 pb-12">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-6xl tracking-tighter leading-none font-semibold text-slate-900">
          15 Best Shanghai Restaurants You Must Try
        </h1>
        <p class="text-lg text-slate-500 mt-6 leading-relaxed max-w-[60ch]">
          Ranked and reviewed by our team of food critics. From legendary soup dumpling spots to Michelin-starred destinations, here are the very best Shanghai restaurants.
        </p>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <h2 class="text-2xl md:text-3xl tracking-tight font-semibold text-slate-900 mb-6">Our Ranked Picks</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {allRestaurants.map((r, i) => (
          <RestaurantCard
            name={r.name}
            cuisine={r.cuisine}
            rating={r.rating}
            priceRange={r.priceRange}
            location={r.location}
            image={r.heroImage}
            href={`/restaurant/${r.slug}`}
            index={i}
          />
        ))}
      </div>
    </section>

    <section class="bg-slate-50 py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl md:text-3xl tracking-tight font-semibold text-slate-900 mb-10">FAQ About Shanghai Restaurants</h2>
        <Faq items={faqsBest} />
      </div>
    </section>
  </main>


  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "15 Best Shanghai Restaurants in 2026",
    "description": "Ranked and reviewed by our team of food critics. From legendary soup dumpling spots to Michelin-starred destinations.",
    "numberOfItems": allRestaurants.length,
    "itemListElement": allRestaurants.map(function(r, i) { return { "@type": "ListItem", "position": i + 1, "item": { "@type": "Restaurant", "name": r.name, "url": "https://shanghai-restaurant.com/restaurant/" + r.slug, "servesCuisine": r.cuisine, "priceRange": r.priceRange } } })
  })} />
</Layout>
