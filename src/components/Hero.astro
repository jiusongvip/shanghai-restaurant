---
export interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28">
  <div class="max-w-3xl">
    <h1 class="text-4xl md:text-6xl tracking-tighter leading-none font-semibold text-slate-900">
      {title}
    </h1>
    <p class="text-lg md:text-xl text-slate-500 mt-6 leading-relaxed max-w-[60ch]">
      {subtitle}
    </p>
  </div>
</section>
