---
// Phosphor-style SVG icons for Astro
// Uses standard Phosphor icon paths (regular weight, 1.5 stroke width)
export interface Props {
  name: "list" | "caret-down" | "arrow-right";
  size?: number;
  class?: string;
}

const icons = {
  "list": "M8 6.25h8M8 12h8M8 17.75h8",
  "caret-down": "M6 9l6 6 6-6",
  "arrow-right": "M3 12h18M15 6l6 6-6 6",
};

const { name, size = 20, class: className = "" } = Astro.props;
const path = icons[name] || "";
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <path d={path} />
</svg>
