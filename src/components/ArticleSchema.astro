---
export interface Props {
  headline: string;
  description: string;
  url: string;
  datePublished?: string;
  dateModified?: string;
}

const { headline, description, url, datePublished = "2026-07-29", dateModified = "2026-09-23" } = Astro.props;
---

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  headline,
  description,
  url,
  datePublished,
  dateModified,
  author: {
    "@type": "Person",
    name: "Li Wei",
  },
  publisher: {
    "@type": "Organization",
    name: "Best Shanghai Restaurants",
    url: "https://www.shanghai-restaurant.com",
  },
})} />
