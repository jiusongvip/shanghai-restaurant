---
export interface Props {
  name: string;
  description: string;
  href: string;
}

const { name, description, href } = Astro.props;
const shortDesc = description.length > 250
  ? description.slice(0, 247).replace(/\s+\S*$/, "") + "..."
  : description;
---

<a href={href} class="group flex flex-col p-5 border border-slate-100 card-soft hover:border-accent-200 hover:bg-accent-50/30 transition-all duration-300">
  <h3 class="text-base font-semibold text-slate-900 group-hover:text-accent-600 transition-colors">{name}</h3>
  <p class="text-sm text-slate-500 mt-1.5 leading-relaxed">{shortDesc}</p>
  <span class="text-sm font-medium text-accent-600 mt-3 group-hover:underline">Explore dishes &rarr;</span>
</a>
